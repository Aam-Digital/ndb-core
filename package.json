{
  "name": "ndb-core",
  "version": "0.0.0",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build --configuration production",
    "test": "ng test",
    "test-ci": "ng test --configuration=ci",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "e2e": "cross-env PW_DISABLE_TS_ESM=1 playwright test",
    "e2e:debug": "cross-env PW_DISABLE_TS_ESM=1 playwright test --ui --timeout=0",
    "compodoc": "npx compodoc -c doc/compodoc_sources/.compodocrc.json",
    "docs:json": "compodoc -p ./tsconfig.json -e json -d .",
    "storybook": "ng run ndb-core:storybook",
    "build-storybook": "ng run ndb-core:build-storybook",
    "extract-i18n": "ng extract-i18n --output-path ./src/assets/locale/",
    "check-circular-deps": "madge --circular --extensions ts ./",
    "test:cli": "vitest run",
    "cli": "tsx cli/main.ts"
  },
  "private": true,
  "browser": {
    "stream": "./node_modules/stream-browserify"
  },
  "imports": {
    "#e2e/*": "./e2e/*"
  },
  "dependencies": {
