    "@angular/service-worker": "^22.1.3",
    "@aytek/material-color-picker": "^1.0.4",
    "@casl/ability": "^6.8.1",
    "@casl/angular": "^9.0.6",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-sql": "^6.10.0",
