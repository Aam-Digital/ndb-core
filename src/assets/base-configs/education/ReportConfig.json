[
  {
    "_id": "ReportConfig:basic-report",
    "title": "Basic Report",
    "reportDefinition": [
      {
        "query": "Child:toArray:filterActive",
        "label": "All children",
        "groupBy": [
          "gender"
        ]
      },
      {
        "query": "School:toArray",
        "label": "All schools",
        "aggregations": [
          {
            "label": "Children attending a school",
            "query": ":getRelated(ChildSchoolRelation, schoolId):filterActive.childId:unique"
          },
          {
            "label": "Governmental schools",
            "query": "[*privateSchool!=true]"
          },
          {
            "query": "[*privateSchool!=true]:getRelated(ChildSchoolRelation, schoolId):filterActive.childId::unique:toEntities(Child)",
            "label": "Children attending a governmental school",
            "groupBy": [
              "gender"
            ]
          },
          {
            "label": "Private schools",
            "query": "[*privateSchool=true]"
          },
          {
            "query": "[*privateSchool=true]:getRelated(ChildSchoolRelation, schoolId):filterActive.childId::unique:toEntities(Child)",
            "label": "Children attending a private school",
            "groupBy": [
              "gender"
            ]
          }
        ]
      }
    ]
  },
  {
    "_id": "ReportConfig:event-report",
    "title": "Event Report",
    "reportDefinition": [
      {
        "query": "Event:toArray[* date >= ? & date <= ?]",
        "groupBy": [
          "category"
        ],
        "label": "Events",
        "aggregations": [
          {
            "query": ":getParticipantsWithAttendance(PRESENT):unique:toEntities(Child)",
            "groupBy": [
              "gender"
            ],
            "label": "Participants"
          }
        ]
      }
    ]
  },
  {
    "_id": "ReportConfig:attendance-report",
    "title": "Attendance Report",
    "mode": "exporting",
    "reportDefinition": [
      {
        "query": "Event:toArray[* date >= ? & date <= ?]",
        "groupBy": {
          "label": "Type",
          "property": "category"
        },
        "subQueries": [
          {
            "query": ":getAttendanceArray:getAttendanceReport",
            "subQueries": [
              {
                "label": "Name",
                "query": ".participant:toEntities(Child).name"
              },
              {
                "query": ".participant:toEntities(Child):getRelated(ChildSchoolRelation, childId):filterActive",
                "subQueries": [
                  {
                    "label": "Class",
                    "query": ".schoolClass"
                  },
                  {
                    "label": "School",
                    "query": ".schoolId:toEntities(School).name"
                  }
                ]
              },
              {
                "label": "Total",
                "query": "total"
              },
              {
                "label": "Present",
                "query": "present"
              },
              {
                "label": "Rate",
                "query": "percentage"
              },
              {
                "label": "Late",
                "query": "detailedStatus.LATE"
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "_id": "ReportConfig:materials-distributed",
    "title": "Materials Distributed",
    "mode": "exporting",
    "reportDefinition": [
      {
        "query": "EducationalMaterial:toArray[*date >= ? & date <= ?]",
        "groupBy": {
          "label": "Type",
          "property": "materialType"
        },
        "subQueries": [
          {
            "label": "Number of events of handing out",
            "query": ".materialAmount:count"
          },
          {
            "label": "Total Items",
            "query": ".materialAmount:sum"
          }
        ]
      }
    ]
  },
  {
    "_id": "ReportConfig:sql-students-anonymized",
    "title": "Students (anonymized, SQL)",
    "mode": "sql",
    "reportDefinition": [
      {
        "query": "SELECT substr(c._id, length('Child:') + 1) AS uuid, COALESCE(g.label, c.gender) AS gender, CASE WHEN c.age IS NULL THEN 'unknown' WHEN c.age < 6 THEN '0-5' WHEN c.age <= 10 THEN '6-10' WHEN c.age <= 14 THEN '11-14' WHEN c.age <= 17 THEN '15-17' ELSE '18+' END AS age_group, c.motherTongue AS mother_tongue, CASE WHEN c.inactive = 1 OR COALESCE(c.dropoutDate, '') <> '' THEN 'inactive' ELSE 'active' END AS status FROM (SELECT *, (strftime('%Y', 'now') - strftime('%Y', dateOfBirth)) - (strftime('%m-%d', 'now') < strftime('%m-%d', dateOfBirth)) AS age FROM Child) c LEFT JOIN ConfigurableEnumOption g ON g.enum_id = 'genders' AND g.option_id = c.gender ORDER BY uuid"
      }
    ]
  },
  {
    "_id": "ReportConfig:sql-attendance-raw",
    "title": "Attendance Raw Data (SQL)",
    "mode": "sql",
    "transformations": {
      "startDate": [
        "SQL_FROM_DATE"
      ],
      "endDate": [
        "SQL_TO_DATE"
      ]
    },
    "reportDefinition": [
      {
        "query": "SELECT substr(e._id, length('Event:') + 1) AS event_id, e.date AS date, a.title AS activity, COALESCE(cat.label, e.category) AS category, substr(json_extract(p.value, '$.participant'), length('Child:') + 1) AS participant_uuid, COALESCE(st.label, json_extract(p.value, '$.status')) AS attendance_status, st.countAs AS counted_as FROM Event e, json_each(e.participants) p LEFT JOIN RecurringActivity a ON a._id = e.parentActivity LEFT JOIN ConfigurableEnumOption cat ON cat.enum_id = 'interaction-type' AND cat.option_id = e.category LEFT JOIN (SELECT json_extract(o.value, '$.id') AS id, json_extract(o.value, '$.label') AS label, json_extract(o.value, '$.countAs') AS countAs FROM ConfigurableEnum ec, json_each(ec.\"values\") o WHERE ec._id = 'ConfigurableEnum:attendance-status') st ON st.id = json_extract(p.value, '$.status') WHERE json_extract(p.value, '$.participant') LIKE 'Child:%' AND e.date BETWEEN $startDate AND $endDate ORDER BY e.date, event_id, participant_uuid"
      }
    ]
  }
]
