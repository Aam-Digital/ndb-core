[
  {
    "_id": "ReportConfig:basic-report",
    "title": "Rapport de base",
    "reportDefinition": [
      {
        "query": "Child:toArray:filterActive",
        "label": "Tous les enfants",
        "groupBy": [
          "gender"
        ]
      },
      {
        "query": "School:toArray",
        "label": "Toutes les écoles",
        "aggregations": [
          {
            "label": "Enfants fréquentant une école",
            "query": ":getRelated(ChildSchoolRelation, schoolId):filterActive.childId:unique"
          },
          {
            "label": "Écoles publiques",
            "query": "[*privateSchool!=true]"
          },
          {
            "query": "[*privateSchool!=true]:getRelated(ChildSchoolRelation, schoolId):filterActive.childId::unique:toEntities(Child)",
            "label": "Enfants fréquentant une école publique",
            "groupBy": [
              "gender"
            ]
          },
          {
            "label": "Écoles privées",
            "query": "[*privateSchool=true]"
          },
          {
            "query": "[*privateSchool=true]:getRelated(ChildSchoolRelation, schoolId):filterActive.childId::unique:toEntities(Child)",
            "label": "Enfants fréquentant une école privée",
            "groupBy": [
              "gender"
            ]
          }
        ]
      }
    ]
  },
  {
    "_id": "ReportConfig:event-report",
    "title": "Rapport d'événement",
    "reportDefinition": [
      {
        "query": "Event:toArray[* date >= ? & date <= ?]",
        "groupBy": [
          "category"
        ],
        "label": "Événements",
        "aggregations": [
          {
            "query": ":getParticipantsWithAttendance(PRESENT):unique:toEntities(Child)",
            "groupBy": [
              "gender"
            ],
            "label": "Participants"
          }
        ]
      }
    ]
  },
  {
    "_id": "ReportConfig:attendance-report",
    "title": "Rapport de présence",
    "mode": "exporting",
    "reportDefinition": [
      {
        "query": "Event:toArray[* date >= ? & date <= ?]",
        "groupBy": {
          "label": "Type",
          "property": "category"
        },
        "subQueries": [
          {
            "query": ":getAttendanceArray:getAttendanceReport",
            "subQueries": [
              {
                "label": "Nom",
                "query": ".participant:toEntities(Child).name"
              },
              {
                "query": ".participant:toEntities(Child):getRelated(ChildSchoolRelation, childId):filterActive",
                "subQueries": [
                  {
                    "label": "Classe",
                    "query": ".schoolClass"
                  },
                  {
                    "label": "École",
                    "query": ".schoolId:toEntities(School).name"
                  }
                ]
              },
              {
                "label": "Total",
                "query": "total"
              },
              {
                "label": "Présent",
                "query": "present"
              },
              {
                "label": "Taux",
                "query": "percentage"
              },
              {
                "label": "Retard",
                "query": "detailedStatus.LATE"
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "_id": "ReportConfig:materials-distributed",
    "title": "Matériels distribués",
    "mode": "exporting",
    "reportDefinition": [
      {
        "query": "EducationalMaterial:toArray[*date >= ? & date <= ?]",
        "groupBy": {
          "label": "Type",
          "property": "materialType"
        },
        "subQueries": [
          {
            "label": "Nombre d'événements de distribution",
            "query": ".materialAmount:count"
          },
          {
            "label": "Total d'articles",
            "query": ".materialAmount:sum"
          }
        ]
      }
    ]
  },
  {
    "_id": "ReportConfig:sql-students-anonymized",
    "title": "Élèves (anonymisés, SQL)",
    "mode": "sql",
    "reportDefinition": [
      {
        "query": "SELECT substr(c._id, length('Child:') + 1) AS uuid, COALESCE(g.label, c.gender) AS genre, CASE WHEN c.age IS NULL THEN 'inconnu' WHEN c.age < 6 THEN '0-5' WHEN c.age <= 10 THEN '6-10' WHEN c.age <= 14 THEN '11-14' WHEN c.age <= 17 THEN '15-17' ELSE '18+' END AS tranche_age, c.motherTongue AS langue_maternelle, CASE WHEN c.inactive = 1 OR COALESCE(c.dropoutDate, '') <> '' THEN 'inactif' ELSE 'actif' END AS statut FROM (SELECT *, (strftime('%Y', 'now') - strftime('%Y', dateOfBirth)) - (strftime('%m-%d', 'now') < strftime('%m-%d', dateOfBirth)) AS age FROM Child) c LEFT JOIN ConfigurableEnumOption g ON g.enum_id = 'genders' AND g.option_id = c.gender ORDER BY uuid"
      }
    ]
  },
  {
    "_id": "ReportConfig:sql-attendance-raw",
    "title": "Présence données brutes (SQL)",
    "mode": "sql",
    "transformations": {
      "startDate": [
        "SQL_FROM_DATE"
      ],
      "endDate": [
        "SQL_TO_DATE"
      ]
    },
    "reportDefinition": [
      {
        "query": "SELECT substr(e._id, length('Event:') + 1) AS evenement_id, e.date AS date, a.title AS activite, COALESCE(cat.label, e.category) AS categorie, substr(json_extract(p.value, '$.participant'), length('Child:') + 1) AS participant_uuid, COALESCE(st.label, json_extract(p.value, '$.status')) AS statut_presence, st.countAs AS compte_comme FROM Event e, json_each(e.participants) p LEFT JOIN RecurringActivity a ON a._id = e.parentActivity LEFT JOIN ConfigurableEnumOption cat ON cat.enum_id = 'interaction-type' AND cat.option_id = e.category LEFT JOIN (SELECT json_extract(o.value, '$.id') AS id, json_extract(o.value, '$.label') AS label, json_extract(o.value, '$.countAs') AS countAs FROM ConfigurableEnum ec, json_each(ec.\"values\") o WHERE ec._id = 'ConfigurableEnum:attendance-status') st ON st.id = json_extract(p.value, '$.status') WHERE json_extract(p.value, '$.participant') LIKE 'Child:%' AND e.date BETWEEN $startDate AND $endDate ORDER BY e.date, evenement_id, participant_uuid"
      }
    ]
  }
]
