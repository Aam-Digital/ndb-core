{
  "_id": "Config:CONFIG_ENTITY",
  "data": {
    "appConfig:usage-analytics": {
      "url": "https://matomo.aam-digital.org",
      "site_id": "8"
    },
    "navigationMenu": {
      "items": [
        {
          "label": {
            "en-US": "Dashboard",
            "ar": "لوحة المعلومات"
          },
          "icon": "home",
          "link": "/"
        },
        {
          "entityType": "Child"
        },
        {
          "entityType": "School"
        },
        {
          "entityType": "Note"
        },
        {
          "entityType": "User"
        },
        {
          "label": {
            "en-US": "Reports",
            "ar": "التقارير"
          },
          "icon": "line-chart",
          "link": "/report"
        }
      ]
    },
    "view:": {
      "component": "Dashboard",
      "config": {
        "widgets": [
          {
            "component": "EntityCountDashboard",
            "config": {
              "entityType": "Child",
              "groupBy": [
                "gender"
              ]
            }
          },
          {
            "component": "ImportantNotesDashboard",
            "config": {
              "warningLevels": [
                "WARNING",
                "URGENT"
              ]
            }
          },
          {
            "component": "ProgressDashboard",
            "config": {
              "dashboardConfigId": "1"
            }
          }
        ]
      }
    },
    "view:note": {
      "component": "EntityList",
      "config": {
        "entityType": "Note",
        "clickMode": "popup-details",
        "title": {
          "en-US": "Notes & Reports",
          "ar": "الملاحظات والتقارير"
        },
        "columnGroups": {
          "groups": [
            {
              "name": "Standard",
              "columns": [
                "date",
                "subject",
                "category",
                "authors",
                "relatedEntities"
              ]
            },
            {
              "name": "Mobile",
              "columns": [
                "date",
                "subject",
                "relatedEntities"
              ]
            }
          ]
        },
        "filters": [
          {
            "id": "warningLevel"
          },
          {
            "id": "date",
            "default": 1
          },
          {
            "id": "category"
          },
          {
            "id": "authors"
          }
        ]
      }
    },
    "entity:Note": {
      "attributes": {
        "relatedEntities": {
          "label": {
            "en-US": "Related Records",
            "ar": "السجلات المرتبطة"
          },
          "dataType": "entity",
          "additional": [
            "Child",
            "School"
          ],
          "isArray": true,
          "entityReferenceRole": "composite",
          "anonymize": "retain"
        }
      }
    },
    "entity:User": {
      "label": {
        "en-US": "User",
        "ar": "مستخدم"
      },
      "labelPlural": {
        "en-US": "Users",
        "ar": "المستخدمون"
      },
      "icon": "user",
      "enableUserAccounts": true,
      "attributes": {
        "name": {
          "dataType": "string",
          "label": {
            "en-US": "Name",
            "ar": "الاسم"
          }
        }
      }
    },
    "view:user": {
      "component": "EntityList",
      "config": {
        "entityType": "User",
        "columns": [
          "name"
        ]
      },
      "permittedUserRoles": [
        "admin_app"
      ]
    },
    "view:user/:id": {
      "component": "EntityDetails",
      "config": {
        "entityType": "User",
        "panels": [
          {
            "title": {
              "en-US": "User Information",
              "ar": "معلومات المستخدم"
            },
            "components": [
              {
                "title": "",
                "component": "Form",
                "config": {
                  "fieldGroups": [
                    {
                      "fields": [
                        "name"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    "entity:School": {
      "toStringAttributes": [
        "name"
      ],
      "icon": "university",
      "label": {
        "en-US": "School",
        "ar": "مدرسة"
      },
      "labelPlural": {
        "en-US": "Schools",
        "ar": "المدارس"
      },
      "color": "#9E9D24",
      "attributes": {
        "name": {
          "dataType": "string",
          "label": {
            "en-US": "Name",
            "ar": "الاسم"
          },
          "validators": {
            "required": true
          },
          "id": "name"
        },
        "privateSchool": {
          "dataType": "boolean",
          "label": {
            "en-US": "Private School",
            "ar": "مدرسة خاصة"
          },
          "id": "privateSchool"
        },
        "language": {
          "dataType": "string",
          "label": {
            "en-US": "Language",
            "ar": "اللغة"
          },
          "id": "language"
        },
        "address": {
          "dataType": "location",
          "label": {
            "en-US": "Address",
            "ar": "العنوان"
          },
          "id": "address"
        },
        "phone": {
          "dataType": "string",
          "label": {
            "en-US": "Phone Number",
            "ar": "رقم الهاتف"
          },
          "id": "phone"
        },
        "timing": {
          "dataType": "string",
          "label": {
            "en-US": "School Timing",
            "ar": "توقيت الدوام المدرسي"
          },
          "id": "timing"
        },
        "remarks": {
          "dataType": "string",
          "label": {
            "en-US": "Remarks",
            "ar": "ملاحظات"
          },
          "id": "remarks"
        },
        "website": {
          "dataType": "url",
          "label": {
            "en-US": "Website",
            "ar": "الموقع الإلكتروني"
          },
          "id": "website"
        },
        "_id": {
          "anonymize": "retain",
          "dataType": "string",
          "id": "_id"
        },
        "_rev": {
          "anonymize": "retain",
          "dataType": "string",
          "id": "_rev"
        },
        "created": {
          "anonymize": "retain",
          "dataType": "update-metadata",
          "id": "created"
        },
        "updated": {
          "anonymize": "retain",
          "dataType": "update-metadata",
          "id": "updated"
        },
        "inactive": {
          "anonymize": "retain",
          "dataType": "boolean",
          "id": "inactive"
        },
        "anonymized": {
          "anonymize": "retain",
          "dataType": "boolean",
          "id": "anonymized"
        }
      },
      "hasPII": false,
      "_id": "entity:School"
    },
    "view:school": {
      "component": "EntityList",
      "config": {
        "entityType": "School",
        "columns": [
          "name",
          {
            "id": "DisplayParticipantsCount",
            "viewComponent": "DisplayParticipantsCount",
            "label": {
              "en-US": "Participants",
              "ar": "المشاركون"
            }
          }
        ],
        "filters": [
          {
            "id": "privateSchool",
            "label": {
              "en-US": "Private School",
              "ar": "مدرسة خاصة"
            }
          }
        ]
      }
    },
    "view:school/:id": {
      "component": "EntityDetails",
      "config": {
        "entityType": "School",
        "panels": [
          {
            "title": {
              "en-US": "Basic Information",
              "ar": "المعلومات الأساسية"
            },
            "components": [
              {
                "title": "",
                "component": "Form",
                "config": {
                  "fieldGroups": [
                    {
                      "fields": [
                        "name",
                        "privateSchool"
                      ]
                    },
                    {
                      "fields": [
                        "address",
                        "phone",
                        "website"
                      ]
                    },
                    {
                      "fields": [
                        "language",
                        "timing"
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "title": {
              "en-US": "Students",
              "ar": "الطلاب"
            },
            "components": [
              {
                "component": "RelatedEntities",
                "config": {
                  "entityType": "ChildSchoolRelation",
                  "columns": [
                    {
                      "id": "childId"
                    },
                    {
                      "id": "start",
                      "visibleFrom": "md"
                    },
                    {
                      "id": "end",
                      "visibleFrom": "md"
                    },
                    {
                      "id": "schoolClass"
                    },
                    {
                      "id": "result"
                    }
                  ],
                  "loaderMethod": "ChildrenServiceQueryRelations"
                }
              }
            ]
          }
        ]
      },
      "_id": "view:school/:id"
    },
    "entity:Child": {
      "label": {
        "en-US": "Participant",
        "ar": "مشارك"
      },
      "labelPlural": {
        "en-US": "Participants",
        "ar": "المشاركون"
      },
      "icon": "person",
      "toStringAttributes": [
        "name"
      ],
      "attributes": {
        "name": {
          "dataType": "string",
          "label": {
            "en-US": "Name",
            "ar": "الاسم"
          },
          "validators": {
            "required": true
          }
        },
        "gender": {
          "dataType": "configurable-enum",
          "additional": "genders",
          "label": {
            "en-US": "Gender",
            "ar": "الجنس"
          }
        }
      }
    },
    "view:child": {
      "component": "EntityList",
      "config": {
        "entityType": "Child",
        "columns": [
          {
            "viewComponent": "EntityBlock",
            "label": {
              "en-US": "Name",
              "ar": "الاسم"
            },
            "id": "name"
          },
          {
            "viewComponent": "DisplayEntity",
            "label": {
              "en-US": "School",
              "ar": "مدرسة"
            },
            "id": "schoolId",
            "additional": "School",
            "noSorting": true
          }
        ],
        "columnGroups": {
          "groups": [
            {
              "name": "Basic Info",
              "columns": [
                "name"
              ]
            }
          ]
        },
        "filters": [
          {
            "id": "gender"
          }
        ],
        "loaderMethod": "ChildrenService"
      }
    },
    "view:child/:id": {
      "component": "EntityDetails",
      "config": {
        "entityType": "Child",
        "panels": [
          {
            "title": {
              "en-US": "Basic Information",
              "ar": "المعلومات الأساسية"
            },
            "components": [
              {
                "title": "",
                "component": "Form",
                "config": {
                  "fieldGroups": [
                    {
                      "fields": [
                        "name"
                      ],
                      "header": {
                        "en-US": "Personal Information",
                        "ar": "المعلومات الشخصية"
                      }
                    },
                    {
                      "fields": [
                        "gender"
                      ],
                      "header": {
                        "en-US": "Additional",
                        "ar": "معلومات إضافية"
                      }
                    }
                  ]
                }
              }
            ]
          },
          {
            "title": {
              "en-US": "Groups",
              "ar": "المجموعات"
            },
            "components": [
              {
                "component": "RelatedEntities",
                "config": {
                  "entityType": "ChildSchoolRelation",
                  "columns": [
                    {
                      "id": "start",
                      "visibleFrom": "sm"
                    },
                    {
                      "id": "end",
                      "visibleFrom": "sm"
                    },
                    "schoolId"
                  ],
                  "loaderMethod": "ChildrenServiceQueryRelations",
                  "showInactive": true,
                  "single": true
                }
              }
            ]
          },
          {
            "title": {
              "en-US": "Notes & Tasks",
              "ar": "الملاحظات والمهام"
            },
            "components": [
              {
                "title": "",
                "component": "NotesRelatedToEntity",
                "config": {
                  "entityType": "Note",
                  "columns": [
                    {
                      "id": "date",
                      "visibleFrom": "xs"
                    },
                    {
                      "id": "subject",
                      "visibleFrom": "xs"
                    },
                    {
                      "id": "text",
                      "visibleFrom": "md"
                    },
                    {
                      "id": "authors",
                      "visibleFrom": "md"
                    },
                    {
                      "id": "warningLevel",
                      "visibleFrom": "md"
                    }
                  ]
                }
              },
              {
                "title": {
                  "en-US": "Tasks",
                  "ar": "المهام"
                },
                "component": "TodosRelatedToEntity",
                "config": {
                  "entityType": "Todo",
                  "columns": [
                    {
                      "id": "deadline"
                    },
                    {
                      "id": "subject"
                    },
                    {
                      "id": "startDate"
                    },
                    {
                      "id": "assignedTo"
                    },
                    {
                      "id": "description",
                      "visibleFrom": "xl"
                    },
                    {
                      "id": "repetitionInterval",
                      "visibleFrom": "xl"
                    },
                    {
                      "id": "relatedEntities",
                      "hideFromTable": true
                    },
                    {
                      "id": "completed",
                      "hideFromForm": true
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    "entity:Todo": {
      "label": {
        "en-US": "Task",
        "ar": "مهمة"
      },
      "labelPlural": {
        "en-US": "Tasks",
        "ar": "المهام"
      },
      "attributes": {}
    },
    "entity:ChildSchoolRelation": {
      "hasPII": true,
      "attributes": {
        "childId": {
          "dataType": "entity",
          "additional": "Child",
          "entityReferenceRole": "composite",
          "validators": {
            "required": true
          },
          "anonymize": "retain",
          "label": {
            "en-US": "Child",
            "ar": "طفل"
          }
        },
        "schoolId": {
          "dataType": "entity",
          "additional": "School",
          "entityReferenceRole": "aggregate",
          "validators": {
            "required": true
          },
          "anonymize": "retain",
          "label": {
            "en-US": "School",
            "ar": "مدرسة"
          }
        },
        "schoolClass": {
          "dataType": "string",
          "label": {
            "en-US": "Class",
            "ar": "الصف"
          },
          "anonymize": "retain"
        },
        "start": {
          "dataType": "date-only",
          "label": {
            "en-US": "Start date",
            "ar": "تاريخ البدء"
          },
          "description": {
            "en-US": "The date a child joins a school",
            "ar": "تاريخ التحاق الطفل بالمدرسة"
          },
          "anonymize": "retain"
        },
        "end": {
          "dataType": "date-only",
          "label": {
            "en-US": "End date",
            "ar": "تاريخ الانتهاء"
          },
          "description": {
            "en-US": "The date of a child leaving the school",
            "ar": "تاريخ مغادرة الطفل للمدرسة"
          },
          "anonymize": "retain"
        },
        "result": {
          "dataType": "percentage",
          "label": {
            "en-US": "Result",
            "ar": "النتيجة"
          },
          "validators": {
            "min": 0,
            "max": 100
          }
        }
      }
    }
  }
}
