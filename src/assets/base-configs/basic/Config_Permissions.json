{
  "_id": "Config:Permissions",
  "data": {
    "_public": [
      {
        "subject": [
          "Config",
          "SiteSettings",
          "PublicFormConfig",
          "ConfigurableEnum"
        ],
        "action": "read"
      },
      {
        "subject": "participantSurvey",
        "action": "create"
      }
    ],
    "_default": [
      {
        "subject": [
          "Config",
          "SiteSettings",
          "PublicFormConfig",
          "ConfigurableEnum"
        ],
        "action": "read"
      },
      {
        "subject": [
          "NotificationConfig",
          "NotificationEvent"
        ],
        "action": "manage"
      },
      {
        "subject": "UserSettings",
        "action": "manage",
        "conditions": {
          "userId": "${user.id}"
        }
      },
      {
        "subject": "all",
        "action": "manage",
        "reason": "Starting point: every logged-in user can access everything. Move this rule into a role before creating roles with restricted access."
      }
    ],
    "admin_app": [
      {
        "subject": "all",
        "action": "manage"
      }
    ]
  }
}
